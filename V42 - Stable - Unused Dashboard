function extractTextSmartly(file) {
  const mimeType = file.getMimeType();
  if (mimeType === 'message/rfc822' || mimeType.startsWith('text/')) {
    return file.getBlob().getDataAsString();
  }
  return performRobustOCR(file);
}

function parseFilenameMetadata(fileName) {
  const parts = fileName.split('_');
  const rawDate = parts.length > 4 ? parts.slice(4).join('_').trim() : "";
  let dateObj = rawDate;
  if (rawDate) {
    const dateParts = rawDate.split('/'); 
    if (dateParts.length === 3) dateObj = new Date(dateParts[2], dateParts[1] - 1, dateParts[0]);
  }
  return {
      clientChampion: parts.length > 0 ? parts[0].trim() : "N/A",
      strat:          parts.length > 1 ? parts[1].trim() : "N/A",
      budget:         parts.length > 2 ? parts[2].trim() : "",
      typeOfDeck:     parts.length > 3 ? parts[3].trim() : "N/A",
      deadline:       dateObj 
  };
}

function createSummaryDoc(aiData, trackingCode, folder, sourceInfo) {
  const summaryDoc = DocumentApp.create(`${trackingCode} - ${aiData.campaignName || 'Untitled'} - Summary`);
  const summaryDocFile = DriveApp.getFileById(summaryDoc.getId());
  folder.addFile(summaryDocFile);
  DriveApp.getRootFolder().removeFile(summaryDocFile);
  
  const body = summaryDoc.getBody();
  addSection(body, "Metadata", sourceInfo);
  
  // Brief Doctor Score Header
  body.appendParagraph(`Brief Quality Score: ${aiData.briefScore}/10`).setHeading(DocumentApp.ParagraphHeading.HEADING2);
  if (aiData.missingInfo && aiData.missingInfo !== "None") {
    body.appendParagraph(`⚠️ Missing Info: ${aiData.missingInfo}`).setForegroundColor("#FF0000");
  }

  addSection(body, "Core Brief Requirements", aiData.summary_brief);
  addSection(body, "Timeline & Period", aiData.summary_campaignPeriod);
  addSection(body, "Target Audience", aiData.summary_targetAudience);
  addSection(body, "Key Deliverables", aiData.summary_campaignDetails);
  addSection(body, "Mandatory Inclusions", aiData.summary_buzzIdeas);
  addSection(body, "Budget Breakdown", aiData.summary_budget);
  
  return summaryDoc;
}

function appendDataToSheet(sheet, trackingCode, fileNameData, aiData, summaryLink, fileLinksArray) {
  const lastRow = sheet.getLastRow() + 1;
  
  // SLA CALCULATION
  const slaDays = calculateSLADays(fileNameData.typeOfDeck, fileNameData.budget);
  // Formula: =WORKDAY(U{row}, {slaDays})
  // U is Generated On (Col 21)
  const slaDateFormula = `=WORKDAY(U${lastRow}, ${slaDays})`;

  sheet.appendRow([
    trackingCode, 
    fileNameData.typeOfDeck, 
    aiData.parentCompany || "N/A", 
    aiData.brand || "N/A", 
    aiData.campaignName || "N/A", 
    fileNameData.budget,           
    fileNameData.strat, 
    fileNameData.clientChampion, 
    aiData.industryOrInternal || "N/A", 
    "", "", 
    fileNameData.deadline, 
    summaryLink,
    fileLinksArray[0], fileLinksArray[1], fileLinksArray[2], fileLinksArray[3], fileLinksArray[4], 
    aiData.briefScore, 
    aiData.missingInfo, 
    new Date(),
    slaDays, 
    slaDateFormula 
  ]);
  sheet.getRange(lastRow, 6).setNumberFormat('"RM" #,##0.00'); 
  // UPDATED: FORCE DD/MM/YYYY FORMAT
  sheet.getRange(lastRow, 12).setNumberFormat('dd/mm/yyyy');
  sheet.getRange(lastRow, 23).setNumberFormat('dd/mm/yyyy');
}

function moveFolderToArchive(sourceFolder, targetParentFolder) {
  const newFolder = targetParentFolder.createFolder(sourceFolder.getName());
  const files = sourceFolder.getFiles();
  while (files.hasNext()) { files.next().moveTo(newFolder); }
  const subFolders = sourceFolder.getFolders();
  while (subFolders.hasNext()) { moveFolderToArchive(subFolders.next(), newFolder); }
  sourceFolder.setTrashed(true);
}

function addSection(body, title, content) {
  body.appendParagraph(title).setHeading(DocumentApp.ParagraphHeading.HEADING1);
  let textToWrite = 'N/A';
  if (content) {
    if (Array.isArray(content)) {
      textToWrite = content.map(item => {
        if (typeof item === 'object' && item !== null) return Object.values(item).join(' - ');
        return String(item);
      }).join('\n');
    } else if (typeof content === 'object') {
      textToWrite = JSON.stringify(content, null, 2);
    } else {
      textToWrite = String(content);
    }
  }
  body.appendParagraph(textToWrite);
}

function performRobustOCR(file) {
  let attempts = 0;
  while (attempts < 3) {
    let tempDocId = null;
    try {
      const fileBlob = file.getBlob();
      const resource = { title: `[TEMP OCR] ${file.getName()}`, mimeType: fileBlob.getContentType() };
      const tempDocFile = Drive.Files.insert(resource, fileBlob, { ocr: true });
      tempDocId = tempDocFile.id;
      const text = DocumentApp.openById(tempDocId).getBody().getText();
      DriveApp.getFileById(tempDocId).setTrashed(true);
      return text; 
    } catch (e) {
      if (tempDocId) try { DriveApp.getFileById(tempDocId).setTrashed(true); } catch(err){}
      if (e.toString().includes("rate limit")) {
        attempts++;
        Utilities.sleep(attempts * 5000); 
      } else {
        return null; 
      }
    }
  }
  return null;
}

// UPDATED: Now accepts 'metadata' to inject filename info into prompt
function getAiDataWithFallback(fileContent, metadata) {
  const API_KEY = PropertiesService.getScriptProperties().getProperty('GEMINI_API_KEY');
  const models = [
    `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-pro:generateContent?key=${API_KEY}`,
    `https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-pro:generateContent?key=${API_KEY}`,
    `https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${API_KEY}`
  ];

  // Helper to format date for AI prompt (Force DD/MM/YYYY)
  let deadlineStr = "Unknown";
  if (metadata.deadline instanceof Date) {
    deadlineStr = Utilities.formatDate(metadata.deadline, Session.getScriptTimeZone(), "dd/MM/yyyy");
  }

  const prompt = `
    You are an expert Strategic Planner performing a "Brief Audit".
    Analyze the provided project documents. 
    
    CRITICAL: You are provided with "Context from Filename" below. 
    Use this metadata (Budget, Deadline, etc.) as confirmed facts. 
    DO NOT mark Budget or Timeline as missing if they appear in the Filename Metadata.
    
    CONTEXT FROM FILENAME:
    - Budget: ${metadata.budget || "Unknown"}
    - Deadline: ${deadlineStr}
    - CC: ${metadata.clientChampion}
    - Strat: ${metadata.strat}
    
    1. EXTRACT key information.
    2. GRADE the brief quality (1-10).
       - If Budget and Deadline are in the Context above, give full points for those categories.
    3. IDENTIFY missing info.
    
    Return ONLY a JSON object:
    "brand", "campaignName", "parentCompany", "industryOrInternal", "summary_brief", "summary_campaignPeriod", "summary_targetAudience", "summary_campaignDetails", "summary_buzzIdeas", "summary_budget", "briefScore", "missingInfo".
    
    Instructions:
    - "brand" & "parentCompany": Title Case.
    - "briefScore": Number.
    - "missingInfo": String. Write "None" if all key info (Budget, Audience, Deliverables, Timeline) is present in either text or metadata.
    
    TEXT TO ANALYZE:
    ${fileContent.substring(0, 80000)} 
  `;
  
  const payload = JSON.stringify({ "contents": [{ "parts": [{ "text": prompt }] }] });
  const options = { 'method': 'post', 'contentType': 'application/json', 'payload': payload, 'muteHttpExceptions': true };

  for (const url of models) {
    try {
      const response = UrlFetchApp.fetch(url, options);
      if (response.getResponseCode() === 200) {
        const json = JSON.parse(response.getContentText());
        const text = json.candidates?.[0]?.content?.parts?.[0]?.text;
        if (text) {
          const cleanJson = text.replace(/```json/g, "").replace(/```/g, "").trim();
          let data = JSON.parse(cleanJson);

          // Logic Updates
          const toTitleCase = (str) => {
            if (!str) return str;
            return str.replace(/\w\S*/g, (txt) => txt.charAt(0).toUpperCase() + txt.substr(1).toLowerCase());
          };
          if (data.brand && data.brand !== "N/A") data.brand = toTitleCase(data.brand);
          if (data.parentCompany && data.parentCompany !== "N/A") data.parentCompany = toTitleCase(data.parentCompany);
          if ((!data.parentCompany || data.parentCompany === "N/A") && (data.brand && data.brand !== "N/A")) data.parentCompany = data.brand;
          if ((!data.brand || data.brand === "N/A") && (data.parentCompany && data.parentCompany !== "N/A")) data.brand = data.parentCompany;
          
          const badNames = ["N/A", "Not Specified", "Not specified", "Untitled", "Unknown", "TBD"];
          if (!data.campaignName || badNames.includes(data.campaignName) || data.campaignName.trim() === "") {
             data.campaignName = `Proposal For ${data.brand || "Client"}`;
          }

          // Force inject Budget/Deadline if AI missed it but Filename has it
          if ((!data.summary_budget || data.summary_budget === "N/A" || data.summary_budget === "Not specified") && metadata.budget) {
             data.summary_budget = `RM ${metadata.budget} (Sourced from filename)`;
          }

          return data;
        }
      }
    } catch (e) { Logger.log(`Model Error: ${e.toString()}`); }
  }
  return null;
}

function generateTrackingCode() {
  const scriptProperties = PropertiesService.getScriptProperties();
  const now = new Date();
  const months = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];
  const datePrefix = months[now.getMonth()] + String(now.getDate()).padStart(2, '0');
  const lastDate = scriptProperties.getProperty('tracking_lastDate');
  let sequence = (lastDate !== datePrefix) ? 'A' : incrementString(scriptProperties.getProperty('tracking_sequence') || 'A');
  scriptProperties.setProperties({ 'tracking_lastDate': datePrefix, 'tracking_sequence': sequence });
  return datePrefix + sequence;
}

function incrementString(str) {
  let carry = 1, result = '';
  for (let i = str.length - 1; i >= 0; i--) {
    let charCode = str.charCodeAt(i) + carry;
    carry = 0;
    if (charCode > 90) { charCode = 65; carry = 1; }
    result = String.fromCharCode(charCode) + result;
  }
  return (carry > 0 ? 'A' : '') + result;
}

function isValidNamingConvention(name) {
  if (name.startsWith("~$")) return false; 
  const parts = name.split('_');
  return parts.length >= 5;
}

function checkAvailableModels() {
  const API_KEY = PropertiesService.getScriptProperties().getProperty('GEMINI_API_KEY');
  if (!API_KEY) { Logger.log("FATAL ERROR: GEMINI_API_KEY not found."); return; }
  const url = `https://generativelanguage.googleapis.com/v1beta/models?key=${API_KEY}`;
  try {
    const response = UrlFetchApp.fetch(url, { 'method': 'get', 'muteHttpExceptions': true });
    Logger.log(response.getContentText());
  } catch (e) { Logger.log(e.toString()); }
}

