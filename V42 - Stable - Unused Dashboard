function createDashboard() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let dashSheet = ss.getSheetByName(CONFIG.dashboardName);
  
  // Reset Dashboard
  if (dashSheet) { ss.deleteSheet(dashSheet); }
  dashSheet = ss.insertSheet(CONFIG.dashboardName, 0); 
  
  // Visual Setup (Remove Gridlines)
  dashSheet.setHiddenGridlines(true);

  // --- 1. GET DATA ---
  const dataSheet = ss.getSheetByName(CONFIG.sheetName);
  const data = dataSheet.getDataRange().getValues();
  const headers = data.shift(); // Remove header row

  // Data Structures for Calculation
  let stratCounts = {};      // { "Name": TotalActiveCount }
  let stratWeeks = {};       // { "Name_WeekNum": Count }
  let panicList = [];        // List of people with >3 decks in a specific week

  // --- 2. CRUNCH THE NUMBERS ---
  data.forEach(row => {
    const strat = row[CONFIG.colIndices.strat - 1]; // Array is 0-indexed
    const status = String(row[CONFIG.colIndices.status - 1]).toLowerCase();
    const deadline = row[CONFIG.colIndices.deadline - 1];

    // Filter: Ignore empty names and Completed tasks
    if (!strat || strat === "N/A" || status === "done" || status === "completed") return;

    // A. Count Active Workload
    if (!stratCounts[strat]) stratCounts[strat] = 0;
    stratCounts[strat]++;

    // B. Check for Weekly Overload
    if (deadline instanceof Date) {
      const weekNum = getWeekNumber(deadline);
      const year = deadline.getFullYear();
      const key = `${strat}_${year}_W${weekNum}`;

      if (!stratWeeks[key]) stratWeeks[key] = 0;
      stratWeeks[key]++;

      // LOGIC: If they hit 4 (meaning >3), add to panic list if not already added
      if (stratWeeks[key] === 4) {
        panicList.push({
          name: strat,
          week: `Week ${weekNum} (${year})`,
          count: "4+ Decks"
        });
      }
    }
  });

  // --- 3. BUILD THE UI ---

  // HEADER
  dashSheet.getRange("B2").setValue("❤️ Team Well-being Monitor").setFontSize(24).setFontWeight("bold");
  dashSheet.getRange("B3").setValue(`Last Updated: ${Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "dd MMM HH:mm")}`);

  // SECTION A: TOTAL UNDONE WORK (The Volume View)
  dashSheet.getRange("B6").setValue("🔥 Current Active Briefs (Undone)").setFontSize(14).setFontWeight("bold").setBackground("#f3f6f4");
  dashSheet.getRange("B7").setValue("Strategist").setFontWeight("bold");
  dashSheet.getRange("C7").setValue("Active Count").setFontWeight("bold");
  dashSheet.getRange("D7").setValue("Status").setFontWeight("bold");

  let row = 8;
  // Convert object to array and sort by count (descending)
  const sortedStrats = Object.keys(stratCounts).map(key => [key, stratCounts[key]]).sort((a, b) => b[1] - a[1]);

  sortedStrats.forEach(([name, count]) => {
    dashSheet.getRange(row, 2).setValue(name);
    dashSheet.getRange(row, 3).setValue(count);
    
    // UPDATED LOGIC: 
    // <=3: Good
    // 4-5: Busy
    // >5: Overloaded
    let health = "🟢 Good";
    if (count > 3) health = "🟡 Busy";
    if (count > 5) health = "🔴 Overloaded";
    
    dashSheet.getRange(row, 4).setValue(health);
    row++;
  });
  
  // Format Table A
  if (row > 8) {
    dashSheet.getRange(7, 2, row - 7, 3).setBorder(true, true, true, true, true, true);
  }

  // SECTION B: BURNOUT WATCH (>3 Decks in 1 Week)
  dashSheet.getRange("F6").setValue("🚨 Burnout Watch (>3 Decks/Week)").setFontSize(14).setFontWeight("bold").setBackground("#f4cccc");
  dashSheet.getRange("F7").setValue("Strategist").setFontWeight("bold");
  dashSheet.getRange("G7").setValue("Crunch Week").setFontWeight("bold");
  dashSheet.getRange("H7").setValue("Note").setFontWeight("bold");

  let alertRow = 8;
  if (panicList.length === 0) {
    dashSheet.getRange(alertRow, 6).setValue("✅ No immediate burnout risks detected.");
  } else {
    panicList.forEach(item => {
      dashSheet.getRange(alertRow, 6).setValue(item.name);
      dashSheet.getRange(alertRow, 7).setValue(item.week);
      dashSheet.getRange(alertRow, 8).setValue("Risk: High Volume Due");
      alertRow++;
    });
    dashSheet.getRange(7, 6, alertRow - 7, 3).setBorder(true, true, true, true, true, true);
  }

  // Formatting Column Widths
  dashSheet.setColumnWidth(1, 20); // Spacer
  dashSheet.setColumnWidth(2, 150); // Name
  dashSheet.setColumnWidth(3, 100); // Count
  dashSheet.setColumnWidth(4, 120); // Status
  dashSheet.setColumnWidth(5, 50);  // Spacer
  dashSheet.setColumnWidth(6, 150); // Name
  dashSheet.setColumnWidth(7, 150); // Week
  dashSheet.setColumnWidth(8, 150); // Note
}

