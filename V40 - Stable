/**
 * Calculates SLA Days based on Type & Budget Rules
 */
function calculateSLADays(type, budgetStr) {
  const t = (type || "").toLowerCase();
  
  // Extract budget number
  let b = 0;
  if (budgetStr) {
    b = parseFloat(String(budgetStr).replace(/[^0-9.]/g, ''));
  }

  // 1. FAST TRACKS
  if (t.includes("topline")) return 1; // 24 Hours
  if (t.includes("revision")) return 3; // 1-3 Days

  // 2. HEAVY LIFTS
  if (t.includes("brand plan") || t.includes("brand review")) return 10; // 6-12 Days -> Avg 10
  if (t.includes("key learning")) return 5;
  if (t.includes("case stud")) return 5;
  if (t.includes("package")) return 14; // 6-21 Days -> Avg 14

  // 3. STANDARD BUDGET LOGIC (REV, Omnia, Industry)
  // Logic from image:
  if (b < 50000) return 2;       // Below 50k: 1-2 Days
  if (b < 300000) return 4;      // 50k-300k: 3-4 Days
  if (b < 500000) return 7;      // 300k-500k: 5-7 Days
  if (b < 800000) return 8;      // 500k-800k: 6-8 Days
  return 12;                     // 800k+: 8-12 Days
}

function createSystemTriggers() {
  const existingTriggers = ScriptApp.getProjectTriggers();
  let timeTriggerExists = false;
  let editTriggerExists = false;

  existingTriggers.forEach(t => {
    if (t.getHandlerFunction() === 'processNewFiles') timeTriggerExists = true;
    if (t.getHandlerFunction() === 'onStatusChange') editTriggerExists = true;
  });

  if (!timeTriggerExists) {
    ScriptApp.newTrigger('processNewFiles').timeBased().everyMinutes(10).create();
  }
  
  if (!editTriggerExists) {
    const sheet = SpreadsheetApp.getActiveSpreadsheet();
    ScriptApp.newTrigger('onStatusChange').forSpreadsheet(sheet).onEdit().create();
  }

  try { SpreadsheetApp.getUi().alert('Success! All automation and notification triggers are set.'); } catch(e) {}
}

function getMention(name) {
  if (!name) return "N/A";
  const cleanName = String(name).trim();
  return `*${cleanName}*`; 
}

function onStatusChange(e) {
  if (!e || !e.range) return;
  const sheet = e.range.getSheet();
  if (sheet.getName() !== CONFIG.sheetName) return;

  const colIndex = e.range.getColumn();
  const rowIndex = e.range.getRow();
  if (rowIndex <= 1) return;

  const project = sheet.getRange(rowIndex, CONFIG.colIndices.project).getValue();
  const brand = sheet.getRange(rowIndex, CONFIG.colIndices.brand).getValue(); 
  const stratName = sheet.getRange(rowIndex, CONFIG.colIndices.strat).getValue();
  const ccName = sheet.getRange(rowIndex, CONFIG.colIndices.cc).getValue();
  const cellValue = e.value || e.range.getValue();
  const newValue = String(cellValue).toLowerCase();

  // 1. STATUS UPDATE
  if (colIndex === CONFIG.colIndices.status) {
    if (newValue === "done" || newValue === "completed") {
      const proposalLink = sheet.getRange(rowIndex, CONFIG.colIndices.proposalLink).getValue();
      const proposalDisplay = proposalLink ? proposalLink : "N/A";
      const message = `✅ *Proposal Completed*\n\n*Brand:* ${brand}\n*Strat:* ${getMention(stratName)} has marked the project as done.\n*Project:* ${project}\n*CC:* ${getMention(ccName)}\n*Proposal:* ${proposalDisplay}`;
      sendWebhook(message);
    }
  }

  // 2. STRAT HANDOVER
  if (colIndex === CONFIG.colIndices.strat && cellValue) {
    const message = `🔄 *Strat Update / Handover*\n\n*Brand:* ${brand}\n*Project:* ${project}\n*Update:* ${getMention(cellValue)} has taken over this project.`;
    sendWebhook(message);
  }

  // 3. DEADLINE CHANGE
  if (colIndex === CONFIG.colIndices.deadline) {
    const newDeadline = e.range.getDisplayValue(); 
    let oldDeadline = e.oldValue || "N/A"; 
    if (oldDeadline !== "N/A" && !isNaN(oldDeadline) && Number(oldDeadline) > 20000) {
      const serial = Number(oldDeadline);
      const dateDate = new Date((serial - 25569) * 86400 * 1000);
      oldDeadline = Utilities.formatDate(dateDate, Session.getScriptTimeZone(), "dd/MM/yyyy");
    }
    if (newDeadline) {
      const message = `📅 *Deadline Updated*\n\n*Brand:* ${brand}\n*Project:* ${project}\n*Old Deadline:* ${oldDeadline}\n*New Deadline:* ${newDeadline}\n\n*CC:* ${getMention(ccName)}\n*Strat:* ${getMention(stratName)}`;
      sendWebhook(message);
    }
  }

  // 4. NEW FILE ADDED
  if (colIndex >= CONFIG.colIndices.linkStart && colIndex <= CONFIG.colIndices.linkEnd && cellValue) {
    const message = `📂 *Additional File Added*\n\n*Brand:* ${brand}\n*Project:* ${project}\n*Update:* Additional brief documents have been added.\n\n*CC:* ${getMention(ccName)}\n*Strat:* ${getMention(stratName)} please review.`;
    sendWebhook(message);
  }
}

function sendWebhook(text) {
  if (!CONFIG.webhookUrl || CONFIG.webhookUrl.includes("PASTE_YOUR")) {
    Logger.log("Webhook URL not set.");
    return;
  }
  const payload = JSON.stringify({ "text": text });
  const options = { 'method': 'post', 'contentType': 'application/json', 'payload': payload, 'muteHttpExceptions': true };
  try { UrlFetchApp.fetch(CONFIG.webhookUrl, options); } catch (e) { Logger.log("Webhook failed: " + e.toString()); }
}

