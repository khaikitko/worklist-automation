function processNewFiles() {
  const newFilesFolder = DriveApp.getFolderById(CONFIG.newFilesFolderId);
  const archiveFolder = DriveApp.getFolderById(CONFIG.archiveFolderId);
  const summaryFolder = DriveApp.getFolderById(CONFIG.summaryDocsFolderId);
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(CONFIG.sheetName);
  
  const files = newFilesFolder.getFiles();
  while (files.hasNext()) {
    const file = files.next();
    processItem(file, sheet, archiveFolder, summaryFolder, false);
  }

  const subFolders = newFilesFolder.getFolders();
  while (subFolders.hasNext()) {
    const folder = subFolders.next();
    processItem(folder, sheet, archiveFolder, summaryFolder, true);
  }
}

function processItem(item, sheet, archiveFolder, summaryFolder, isFolder) {
  const name = item.getName();
  if (!isValidNamingConvention(name)) {
    Logger.log(`[SKIP] Ignored (Wrong Format): ${name}`);
    return;
  }

  Logger.log(`Processing: ${name}`);
  const fileNameData = parseFilenameMetadata(name); // Parse Metadata FIRST
  
  // Extract Text
  let text = "";
  let fileLinks = ["", "", "", "", ""];
  let filesCount = 0;

  if (isFolder) {
    const folderFiles = item.getFiles();
    let i = 0;
    while (folderFiles.hasNext()) {
      const f = folderFiles.next();
      if (i < 5) fileLinks[i] = `=HYPERLINK("${f.getUrl()}", "📂 Open File")`;
      Logger.log(`Reading file ${i+1}: ${f.getName()}`);
      let extracted = extractTextSmartly(f);
      if (extracted) text += `\n\n--- FILE: ${f.getName()} ---\n${extracted}\n`;
      i++;
      filesCount++;
      Utilities.sleep(1000);
    }
    if (filesCount === 0) return; 
  } else {
    text = extractTextSmartly(item);
    fileLinks[0] = `=HYPERLINK("${item.getUrl()}", "📂 Open File")`;
  }

  if (text) {
    // --- GEMINI ANALYSIS (With Metadata Injection) ---
    // We pass 'fileNameData' to the AI so it knows the Budget/Deadline exists
    let aiData = getAiDataWithFallback(text, fileNameData);
    
    if (aiData) {
      const trackingCode = generateTrackingCode();
      const summaryDoc = createSummaryDoc(aiData, trackingCode, summaryFolder, `Source: ${name}`);
      const summaryLink = `=HYPERLINK("${summaryDoc.getUrl()}", "📄 View Summary")`;

      // APPEND TO SHEET
      appendDataToSheet(sheet, trackingCode, fileNameData, aiData, summaryLink, fileLinks);
      
      // NOTIFY
      let scoreEmoji = aiData.briefScore >= 7 ? "🟢" : (aiData.briefScore >= 5 ? "🟡" : "🔴");
      let budgetDisplay = fileNameData.budget ? `RM ${fileNameData.budget}` : "N/A";

      const notifyMsg = `🚀 *New Brief Uploaded*\n\n*Brand:* ${aiData.brand}\n*Project:* ${aiData.campaignName}\n*Budget:* ${budgetDisplay}\n*Score:* ${scoreEmoji} ${aiData.briefScore}/10\n*Missing:* ${aiData.missingInfo || "None"}\n\n*CC:* ${getMention(fileNameData.clientChampion)}\n*Strat:* ${getMention(fileNameData.strat)}`;
      sendWebhook(notifyMsg);

      if (isFolder) moveFolderToArchive(item, archiveFolder);
      else item.moveTo(archiveFolder);
    }
  }
}

