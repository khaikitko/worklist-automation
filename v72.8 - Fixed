function calculateSLADays(type, budgetStr) {
  const t = (type || "").toLowerCase();
  let b = 0;
  if (budgetStr) {
    b = parseFloat(String(budgetStr).replace(/[^0-9.]/g, ''));
  }
  if (t.includes("topline")) return 1;
  if (t.includes("revision")) return 3; 
  if (t.includes("brand plan") || t.includes("brand review")) return 10; 
  if (t.includes("key learning")) return 5;
  if (t.includes("case stud")) return 5;
  if (t.includes("package")) return 14; 
  if (b < 50000) return 2;
  if (b < 300000) return 4;      
  if (b < 500000) return 7;      
  if (b < 800000) return 8;      
  return 12;
}

function createSystemTriggers() {
  const existingTriggers = ScriptApp.getProjectTriggers();
  let timeTriggerExists = false;
  let editTriggerExists = false;
  let overdueTriggerExists = false;
  let monthlyReportExists = false;
  let annualReportExists = false;
  let sixHourTriggerExists = false;

  existingTriggers.forEach(t => {
    if (t.getHandlerFunction() === 'processNewFiles') timeTriggerExists = true;
    if (t.getHandlerFunction() === 'onStatusChange') editTriggerExists = true;
    if (t.getHandlerFunction() === 'checkOverdueDeadlines') overdueTriggerExists = true;
    if (t.getHandlerFunction() === 'sendMonthlyExecutiveReport') monthlyReportExists = true;
    if (t.getHandlerFunction() === 'sendAnnualExecutiveReportTrigger') annualReportExists = true;
    if (t.getHandlerFunction() === 'updateSignedCampaignsProgress') sixHourTriggerExists = true;
  });

  if (!timeTriggerExists) ScriptApp.newTrigger('processNewFiles').timeBased().everyMinutes(10).create();
  if (!editTriggerExists) ScriptApp.newTrigger('onStatusChange').forSpreadsheet(SpreadsheetApp.getActiveSpreadsheet()).onEdit().create();
  if (!overdueTriggerExists) ScriptApp.newTrigger('checkOverdueDeadlines').timeBased().atHour(9).everyDays(1).create();
  if (!monthlyReportExists) ScriptApp.newTrigger('sendMonthlyExecutiveReport').timeBased().onMonthDay(1).atHour(8).create();
  if (!annualReportExists) ScriptApp.newTrigger('sendAnnualExecutiveReportTrigger').timeBased().onMonthDay(1).atHour(8).create();
  if (!sixHourTriggerExists) ScriptApp.newTrigger('updateSignedCampaignsProgress').timeBased().everyHours(6).create();

  try { SpreadsheetApp.getUi().alert('Success! All automation and notification triggers are set.');
  } catch(e) {}
}

