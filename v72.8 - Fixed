// CUSTOM DATE PARSER FOR "11-May-26" FORMAT
function parsePerformanceDate(dateStr) {
  if (!dateStr) return null;
  if (dateStr instanceof Date) return dateStr;
  
  const parts = String(dateStr).trim().split('-');
  if (parts.length === 3) {
    const day = parseInt(parts[0], 10);
    const monthStr = parts[1].toUpperCase();
    const year = parseInt(parts[2], 10) + 2000; // Assuming 2000s
    const months = { "JAN":0, "FEB":1, "MAR":2, "APR":3, "MAY":4, "JUN":5, "JUL":6, "AUG":7, "SEP":8, "OCT":9, "NOV":10, "DEC":11 };
    
    if (months[monthStr] !== undefined && !isNaN(day) && !isNaN(year)) {
       return new Date(year, months[monthStr], day);
    }
  }
  return null;
}

// LONGEST COMMON PREFIX EXTRACTOR FOR CAMPAIGN NAMES
function getCommonPrefix(namesArray) {
  if (!namesArray || namesArray.length === 0) return "N/A";
  if (namesArray.length === 1) return namesArray[0].trim();
  
  let prefix = namesArray[0];
  for (let i = 1; i < namesArray.length; i++) {
    while (namesArray[i].indexOf(prefix) !== 0) {
      prefix = prefix.substring(0, prefix.length - 1);
      if (prefix === "") return "Multiple Campaigns";
    }
  }
  return prefix.trim();
}

