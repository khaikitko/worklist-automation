function fetchAndAggregateCampaignData(baseCode) {
   if (!CONFIG.campaignPerformanceSheetId || CONFIG.campaignPerformanceSheetId.includes("PLACEHOLDER")) return null;
   
   let perfSs;
   try { perfSs = SpreadsheetApp.openById(CONFIG.campaignPerformanceSheetId); } 
   catch(e) { Logger.log("Cannot open Performance sheet. Check ID and Permissions."); return null; }
   
   const sheet = perfSs.getSheets()[0]; 
   const data = sheet.getDataRange().getValues();
   
   let totalGross = 0, totalNet = 0, totalProgress = 0, matchCount = 0;
   let startDates = [], endDates = [], campaignNames = [];
   let foundIoLink = "";
   const pIdx = CONFIG.perfColIndices;
   
   for (let i = 1; i < data.length; i++) {
     const row = data[i];
     const code = String(row[pIdx.code - 1] || "").trim();
     
     // V72.6: STRICT MATCHING (Matches exact baseCode, or baseCode + up to 2 letters like MAY26008A)
     if (code === baseCode || (code.startsWith(baseCode) && code.length <= baseCode.length + 2)) {
        
        let rawGross = String(row[pIdx.gross - 1] || "0").replace(/[^0-9.-]/g, '');
        let rawNet = String(row[pIdx.net - 1] || "0").replace(/[^0-9.-]/g, '');
        totalGross += parseFloat(rawGross) || 0;
        totalNet += parseFloat(rawNet) || 0;
        
        // V72.6: CUSTOM DATE PARSING
        const sDate = parsePerformanceDate(row[pIdx.start - 1]);
        if (sDate) startDates.push(sDate);
        
        const eDate = parsePerformanceDate(row[pIdx.end - 1]);
        if (eDate) endDates.push(eDate);

        // V72.6: CAMPAIGN NAME COLLECTION
        const cName = String(row[pIdx.campaignName - 1] || "").trim();
        if (cName) campaignNames.push(cName);
        
        // -------------------------------------------------------------------
        // V72.6.1: EXTRACT IO LINK FROM SMART CHIP (Memory Optimized)
        // -------------------------------------------------------------------
        if (!foundIoLink) {
           // i + 1 because sheet rows are 1-indexed, but our loop array is 0-indexed
           let cellRichText = sheet.getRange(i + 1, pIdx.ioLink).getRichTextValue();
           if (cellRichText) {
               let link = cellRichText.getLinkUrl();
               if (link) foundIoLink = `=HYPERLINK("${link}", "📄 View IO")`;
           }
        }

        // SAFELY PARSE PROGRESS TO DECIMAL
        let progRaw = String(row[pIdx.progress - 1] || "0");
        let progVal = parseFloat(progRaw.replace(/[^0-9.-]/g, '')) || 0;
        if (progRaw.includes('%') || progVal > 1) { progVal = progVal / 100; }
        
        totalProgress += progVal;
        matchCount++;
     }
   }
   
   if (matchCount === 0) return null;
   
   const avgProgress = totalProgress / matchCount;
   const minStart = startDates.length > 0 ? new Date(Math.min.apply(null, startDates)) : "N/A";
   const maxEnd = endDates.length > 0 ? new Date(Math.max.apply(null, endDates)) : "N/A";
   const finalCampaignName = getCommonPrefix(campaignNames);

   return { 
     gross: totalGross, 
     net: totalNet, 
     startDate: minStart, 
     endDate: maxEnd, 
     progress: avgProgress,
     campaignName: finalCampaignName,
     ioLink: foundIoLink || "N/A"
   };
}

function updateSignedCampaignsProgress() {
   const ss = SpreadsheetApp.getActiveSpreadsheet();
   const signedSheet = ss.getSheetByName(CONFIG.signedCampaignsSheetName);
   if (!signedSheet) return;
   
   const data = signedSheet.getDataRange().getValues();
   if (data.length <= 1) return;
   
   for (let i = 1; i < data.length; i++) {
     const baseCode = data[i][0];
     const stratName = data[i][2]; // Index 2 because Campaign Name is now Index 1
     const existingProposalLink = data[i][8] || ""; // Index 8 is Proposal Link
     
     if (baseCode) {
        const aggData = fetchAndAggregateCampaignData(baseCode);
        if (aggData) {
          const rowData = [ 
            baseCode, aggData.campaignName, stratName, aggData.gross, aggData.net, 
            aggData.startDate, aggData.endDate, aggData.progress, existingProposalLink, aggData.ioLink, new Date() 
          ];
          signedSheet.getRange(i + 1, 1, 1, 11).setValues([rowData]);
        }
     }
   }
}

// --- MONTHLY & ANNUAL EXECUTIVE REPORTS ---

function sendMonthlyExecutiveReport(isManual = false) {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(CONFIG.sheetName);
  if (!sheet) return;

  const today = new Date();
  let targetMonth = today.getMonth() - 1;
  let targetYear = today.getFullYear();

  if (targetMonth < 0) { targetMonth = 11; targetYear--; }

  generateAndSendReport(sheet, targetMonth, targetYear, "Monthly");
}

function sendAnnualExecutiveReport(isManual = false) {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(CONFIG.sheetName);
  if (!sheet) return;

  const today = new Date();
  const targetYear = today.getFullYear() - 1;

  generateAndSendReport(sheet, null, targetYear, "Annual");
}

function generateAndSendReport(sheet, targetMonth, targetYear, reportType) {
  const data = sheet.getDataRange().getValues();
  const headers = data.shift();
  
  let totalBriefs = 0, totalBudget = 0, completedCount = 0, totalScore = 0, scoredBriefsCount = 0;
  let stratCounts = {}, deckTypes = {};
  
  data.forEach(row => {
    const generatedOn = row[20]; // Column U
    
    if (generatedOn instanceof Date) {
      const matchMonth = (targetMonth === null) ? true : (generatedOn.getMonth() === targetMonth);
      if (matchMonth && generatedOn.getFullYear() === targetYear) {
        totalBriefs++;
        
        let rawBudget = String(row[5] || "0").replace(/[^0-9.]/g, '');
        let budgetVal = parseFloat(rawBudget);
        if (!isNaN(budgetVal)) totalBudget += budgetVal;

        const status = String(row[9]).toLowerCase(); // Column J
        if (status === "done" || status === "completed") completedCount++;

        const strat = row[6]; // Column G
        if (strat && strat !== "N/A") {
          if (!stratCounts[strat]) stratCounts[strat] = { count: 0, budget: 0 };
          
          stratCounts[strat].count++;
          stratCounts[strat].budget += budgetVal || 0;
        }

        const score = parseFloat(row[18]); // Column S
        if (!isNaN(score) && score > 0) { totalScore += score;
          scoredBriefsCount++; }

        const deckType = row[1] || "Unknown";
        // Column B
        deckTypes[deckType] = (deckTypes[deckType] || 0) + 1;
      }
    }
  });

  if (totalBriefs === 0) {
    SpreadsheetApp.getUi().alert(`No data found for ${reportType} report target.`);
    return;
  }

  const completionRate = Math.round((completedCount / totalBriefs) * 100) + "%";
  const averageScore = scoredBriefsCount > 0 ? (totalScore / scoredBriefsCount).toFixed(1) : "N/A";
  const formattedBudget = "RM " + totalBudget.toLocaleString('en-MY', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  
  let stratHtmlList = "";
  let sortedStrats = Object.entries(stratCounts).sort((a, b) => b[1].count - a[1].count);
  sortedStrats.forEach(([name, data]) => {
    const budgFmt = "RM " + data.budget.toLocaleString('en-MY', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
    stratHtmlList += `<li><strong>${name}</strong>: ${data.count} briefs (${budgFmt})</li>`;
  });

  let deckHtmlList = "";
  let sortedDecks = Object.entries(deckTypes).sort((a, b) => b[1] - a[1]);
  sortedDecks.forEach(([type, count]) => { deckHtmlList += `<li><strong>${type}</strong>: ${count}</li>`; });

  const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
  const titlePeriod = reportType === "Monthly" ? `${monthNames[targetMonth]} ${targetYear}` : `Year in Review: ${targetYear}`;
  
  const subject = `📊 ${reportType} Strategy Department Report - ${titlePeriod}`;
  const htmlBody = `
    <div style="font-family: Arial, sans-serif; color: #333; line-height: 1.6; max-width: 600px; border: 1px solid #ddd; border-radius: 8px; padding: 20px;">
      <h2 style="color: #0b5394; text-align: center; border-bottom: 2px solid #0b5394; padding-bottom: 10px;">
        Strategy Dept. ${reportType} Report - ${titlePeriod}
      </h2>
      <h3 style="color: #444; border-bottom: 1px solid #eee; padding-bottom: 5px;">📈 1. Pipeline & Volume</h3>
      <p style="margin: 5px 0;"><strong>Total Briefs Received:</strong> ${totalBriefs}</p>
      <p style="margin: 5px 0;"><strong>Total Budget Pipeline:</strong> ${formattedBudget}</p>
      <p style="margin: 5px 0;"><strong>Completion Rate:</strong> ${completionRate} (${completedCount}/${totalBriefs} finished)</p>
      <br>
      <h3 style="color: #444; border-bottom: 1px solid #eee; padding-bottom: 5px;">🧠 2. Quality Control (AI Graded)</h3>
      <p style="margin: 5px 0;"><strong>Average Incoming Brief Score:</strong> ${averageScore} / 10</p>
      <p style="margin: 10px 0 5px 0;"><strong>Top Requested Deck Types:</strong></p>
      <ul style="margin-top: 0; padding-left: 20px;">${deckHtmlList}</ul>
      <br>
      <h3 style="color: #444; border-bottom: 1px solid #eee; padding-bottom: 5px;">❤️ 3. Team Health & Capacity</h3>
      <p style="margin: 10px 0 5px 0;"><strong>Workload Distribution & Budget Handled:</strong></p>
      <ul style="margin-top: 0; padding-left: 20px;">${stratHtmlList}</ul>
      <div style="margin-top: 30px; padding: 15px; background-color: #f9f9f9; text-align: center; font-size: 12px; color: #777; border-radius: 4px;">
        This is an automated executive summary generated from the Strategy Work List dashboard.
      </div>
    </div>
  `;

  if (CONFIG.leadershipEmails) {
    MailApp.sendEmail({ to: CONFIG.leadershipEmails, subject: subject, htmlBody: htmlBody });
  } else { Logger.log("No leadership email configured."); }
}
