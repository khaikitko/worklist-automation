    You are an expert Strategic Planner performing a "Brief Audit".
    Analyze the provided project documents. 
    
    CONTEXT FROM FILENAME:
    - Budget: ${metadata.budget || "Unknown"}
    - Deadline: ${deadlineStr}
    - CC: ${metadata.clientChampion}
    - Strat: ${metadata.strat}
    
    1. EXTRACT key information.
    2. GRADE the brief quality (1-10).
    3. IDENTIFY missing info.
    4. CLASSIFY the industry ("industryOrInternal") strictly using the list below.
    
    APPROVED INDUSTRIES LIST:
    ${APPROVED_INDUSTRIES}
    
    INSTRUCTION: If the industry does not match exactly, choose the closest one from the list.
    
    Return ONLY a JSON object:
    "brand", "campaignName", "parentCompany", "industryOrInternal", "summary_brief", "summary_campaignPeriod", "summary_targetAudience", "summary_campaignDetails", "summary_buzzIdeas", "summary_budget", "briefScore", "missingInfo".
    
    IMPORTANT FORMATTING:
    - Retain the exact casing for "brand" and "parentCompany" as they appear in the text (e.g., "BSN", "foodpanda", "Samsung"). Do NOT force Title Case.
    
    TEXT TO ANALYZE:
    ${fileContent.substring(0, 80000)} 
  `;
  
  const payload = JSON.stringify({ "contents": [{ "parts": [{ "text": prompt }] }] });
  const options = { 'method': 'post', 'contentType': 'application/json', 'payload': payload, 'muteHttpExceptions': true };

  for (const url of models) {
    try {
      const response = UrlFetchApp.fetch(url, options);
      const code = response.getResponseCode();
      Logger.log(`[DEBUG] Gemini Response Code: ${code} for URL: ${url}`);
      
      if (code === 429) {
         Logger.log("Rate limit (429) hit. Cooling down for 30 seconds...");
         Utilities.sleep(30000); 
         continue; 
      }

      if (code === 200) {
        const rawJson = response.getContentText();
        const json = JSON.parse(rawJson);
        const text = json.candidates?.[0]?.content?.parts?.[0]?.text;
        
        if (!text) {
           Logger.log(`[DEBUG] Gemini Finish Reason: ${json.candidates?.[0]?.finishReason}`);
           Logger.log(`[DEBUG] Gemini Safety Ratings: ${JSON.stringify(json.candidates?.[0]?.safetyRatings)}`);
        }

        if (text) {
          const cleanJson = text.replace(/```json/g, "").replace(/```/g, "").trim();
          let data = JSON.parse(cleanJson);
          
          const badNames = ["N/A", "Not Specified", "Not specified", "Untitled", "Unknown", "TBD"];
          if (!data.campaignName || badNames.includes(data.campaignName) || data.campaignName.trim() === "") {
             data.campaignName = `Proposal For ${data.brand || "Client"}`;
          }

          if ((!data.summary_budget || data.summary_budget === "N/A" || data.summary_budget === "Not specified") && metadata.budget) {
             data.summary_budget = `RM ${metadata.budget} (Sourced from filename)`;
          }

          if (Array.isArray(data.missingInfo)) {
             data.missingInfo = data.missingInfo.join(", ");
          } else if (typeof data.missingInfo === 'object') {
             data.missingInfo = JSON.stringify(data.missingInfo).replace(/"/g, '').replace(/[[\]{}]/g, '');
          }

          return data;
        }
      }
    } catch (e) { Logger.log(`Model Error: ${e.toString()}`); }
  }
  return null;
}

function generateTrackingCode() {
  const scriptProperties = PropertiesService.getScriptProperties();
  const now = new Date();
  const months = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];
  const datePrefix = months[now.getMonth()] + String(now.getDate()).padStart(2, '0');
  const lastDate = scriptProperties.getProperty('tracking_lastDate');
  let sequence = (lastDate !== datePrefix) ? 'A' : incrementString(scriptProperties.getProperty('tracking_sequence') || 'A');
  scriptProperties.setProperties({ 'tracking_lastDate': datePrefix, 'tracking_sequence': sequence });
  return datePrefix + sequence;
}

function incrementString(str) {
  let carry = 1, result = '';
  for (let i = str.length - 1; i >= 0; i--) {
    let charCode = str.charCodeAt(i) + carry;
    carry = 0;
    if (charCode > 90) { charCode = 65; carry = 1; }
    result = String.fromCharCode(charCode) + result;
  }
  return (carry > 0 ? 'A' : '') + result;
}

function isValidNamingConvention(name) {
  if (name.startsWith("~$")) return false; 
  const parts = name.split('_');
  return parts.length >= 5;
}

