function createDashboard() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let dashSheet = ss.getSheetByName(CONFIG.dashboardName);
  
  if (dashSheet) { ss.deleteSheet(dashSheet); }
  dashSheet = ss.insertSheet(CONFIG.dashboardName, 0); 
  dashSheet.setHiddenGridlines(true);

  // --- 1. GET DATA ---
  const dataSheet = ss.getSheetByName(CONFIG.sheetName);
  if (!dataSheet) return; 
  const data = dataSheet.getDataRange().getValues();
  const headers = data.shift(); 

  let activeProjects = [];   
  let stratWeeks = {};       

  // --- 2. CRUNCH THE NUMBERS ---
  data.forEach(row => {
    const strat = row[CONFIG.colIndices.strat - 1]; 
    const status = String(row[CONFIG.colIndices.status - 1]).toLowerCase();
    const brand = row[CONFIG.colIndices.brand - 1];
    const project = row[CONFIG.colIndices.project - 1];
    const deadline = row[CONFIG.colIndices.deadline - 1];

    if (!strat || strat === "N/A" || status === "done" || status === "completed") return;

    let deadlineStr = "N/A";
    if (deadline instanceof Date) {
      deadlineStr = Utilities.formatDate(deadline, Session.getScriptTimeZone(), "dd/MM");
    }
    activeProjects.push([strat, brand, project, deadlineStr]);

    if (deadline instanceof Date) {
      const weekNum = getWeekNumber(deadline);
      const year = deadline.getFullYear();
      const key = `${strat}_${year}_W${weekNum}`;
      if (!stratWeeks[key]) stratWeeks[key] = [];
      stratWeeks[key].push(deadlineStr);
    }
  });

  activeProjects.sort((a, b) => a[0].localeCompare(b[0]));

  // --- 3. BUILD THE UI ---
  dashSheet.getRange("C3").setValue("❤️ Team Well-being Monitor").setFontSize(24).setFontWeight("bold");
  dashSheet.getRange("C4").setValue(`Last Updated: ${Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "dd MMM HH:mm")}`);
  dashSheet.getRange("B6:K6").setBorder(null, null, true, null, null, null, "black", SpreadsheetApp.BorderStyle.SOLID);

  // SECTION A: FULL ACTIVE LIST
  dashSheet.getRange("C8").setValue("🔥 Active Brief List (Ongoing)").setFontSize(14).setFontWeight("bold");
  const listHeaders = [["Strategist", "Brand", "Proposal", "Due Date"]];
  dashSheet.getRange("C9:F9").setValues(listHeaders)
    .setFontWeight("bold").setBackground("#000000").setFontColor("#ffffff")
    .setBorder(true, true, true, true, true, true)
    .setHorizontalAlignment("center").setVerticalAlignment("middle");

  let leftRows = 0;
  if (activeProjects.length > 0) {
    leftRows = activeProjects.length;
    dashSheet.getRange(10, 3, leftRows, 4).setValues(activeProjects)
      .setBorder(true, true, true, true, true, true)
      .setHorizontalAlignment("center").setVerticalAlignment("middle");
  } else {
    dashSheet.getRange("C10").setValue("No active briefs!");
    leftRows = 1;
  }

  // SECTION B: OVERLOAD WATCH
  dashSheet.getRange("H8").setValue("🚨 Overload Watch (>3 Decks/Week)").setFontSize(14).setFontWeight("bold").setFontColor("black");
  const burnoutHeaders = [["Strategist", "Critical Dates (Deadlines)", "Count"]];
  dashSheet.getRange("H9:J9").setValues(burnoutHeaders)
    .setFontWeight("bold").setBackground("#ff0000").setFontColor("#ffffff")
    .setBorder(true, true, true, true, true, true)
    .setHorizontalAlignment("center").setVerticalAlignment("middle");

