function extractTextSmartly(file) {
  const mimeType = file.getMimeType();
  if (mimeType === 'message/rfc822' || mimeType.startsWith('text/')) {
    return file.getBlob().getDataAsString();
  }
  // Try OCR but return empty string if it fails completely (safety net)
  return performRobustOCR(file) || ""; 
}

function parseFilenameMetadata(fileName) {
  const parts = fileName.split('_');
  const rawDate = parts.length > 4 ? parts.slice(4).join('_').trim() : "";
  let dateObj = rawDate;
  if (rawDate) {
    const dateParts = rawDate.split('/'); 
    if (dateParts.length === 3) dateObj = new Date(dateParts[2], dateParts[1] - 1, dateParts[0]);
  }
  return {
      clientChampion: parts.length > 0 ? parts[0].trim() : "N/A",
      strat:          parts.length > 1 ? parts[1].trim() : "N/A",
      budget:         parts.length > 2 ? parts[2].trim() : "",
      typeOfDeck:     parts.length > 3 ? parts[3].trim() : "N/A",
      deadline:       dateObj 
  };
}

function createSummaryDoc(aiData, trackingCode, folder, sourceInfo) {
  const summaryDoc = DocumentApp.create(`${trackingCode} - ${aiData.campaignName || 'Untitled'} - Summary`);
  const summaryDocFile = DriveApp.getFileById(summaryDoc.getId());
  folder.addFile(summaryDocFile);
  DriveApp.getRootFolder().removeFile(summaryDocFile);
  
  const body = summaryDoc.getBody();
  addSection(body, "Metadata", sourceInfo);
  
  body.appendParagraph(`Brief Quality Score: ${aiData.briefScore}/10`).setHeading(DocumentApp.ParagraphHeading.HEADING2);
  if (aiData.missingInfo && aiData.missingInfo !== "None") {
    body.appendParagraph(`⚠️ Missing Info: ${aiData.missingInfo}`).setForegroundColor("#FF0000");
  }

  addSection(body, "Core Brief Requirements", aiData.summary_brief);
  addSection(body, "Timeline & Period", aiData.summary_campaignPeriod);
  addSection(body, "Target Audience", aiData.summary_targetAudience);
  addSection(body, "Key Deliverables", aiData.summary_campaignDetails);
  addSection(body, "Mandatory Inclusions", aiData.summary_buzzIdeas);
  addSection(body, "Budget Breakdown", aiData.summary_budget);
  
  return summaryDoc;
}

function appendDataToSheet(sheet, trackingCode, fileNameData, aiData, summaryLink, fileLinksArray) {
  const lastRow = sheet.getLastRow() + 1;
  const slaDays = calculateSLADays(fileNameData.typeOfDeck, fileNameData.budget);
  const slaDateFormula = `=WORKDAY(U${lastRow}, ${slaDays})`;

  let missingInfoClean = aiData.missingInfo;
  if (Array.isArray(missingInfoClean)) {
    missingInfoClean = missingInfoClean.join(", ");
  } else if (typeof missingInfoClean === 'object') {
    missingInfoClean = JSON.stringify(missingInfoClean).replace(/"/g, '').replace(/[[\]{}]/g, '');
  }

  sheet.appendRow([
    trackingCode, 
    fileNameData.typeOfDeck, 
    aiData.parentCompany || "N/A", 
    aiData.brand || "N/A", 
    aiData.campaignName || "N/A", 
    fileNameData.budget,           
    fileNameData.strat, 
    fileNameData.clientChampion, 
    aiData.industryOrInternal || "N/A", 
    "", "", 
    fileNameData.deadline, 
    summaryLink,
    fileLinksArray[0], fileLinksArray[1], fileLinksArray[2], fileLinksArray[3], fileLinksArray[4], 
    aiData.briefScore, 
    missingInfoClean, 
    new Date(),
    slaDays, 
    slaDateFormula 
  ]);
  sheet.getRange(lastRow, 6).setNumberFormat('"RM" #,##0.00'); 
  sheet.getRange(lastRow, 12).setNumberFormat('dd/mm/yyyy');
  sheet.getRange(lastRow, 23).setNumberFormat('dd/mm/yyyy');
}

function moveFolderToArchive(sourceFolder, targetParentFolder) {
  const newFolder = targetParentFolder.createFolder(sourceFolder.getName());
  const files = sourceFolder.getFiles();
  while (files.hasNext()) { files.next().moveTo(newFolder); }
  const subFolders = sourceFolder.getFolders();
  while (subFolders.hasNext()) { moveFolderToArchive(subFolders.next(), newFolder); }
  sourceFolder.setTrashed(true);
}

function addSection(body, title, content) {
  body.appendParagraph(title).setHeading(DocumentApp.ParagraphHeading.HEADING1);
  let textToWrite = 'N/A';
  if (content) {
    if (Array.isArray(content)) {
      textToWrite = content.map(item => {
        if (typeof item === 'object' && item !== null) return Object.values(item).join(' - ');
        return String(item);
      }).join('\n');
    } else if (typeof content === 'object') {
      textToWrite = JSON.stringify(content, null, 2);
    } else {
      textToWrite = String(content);
    }
  }
  body.appendParagraph(textToWrite);
}

function performRobustOCR(file) {
  let attempts = 0;
  while (attempts < 3) {
    let tempDocId = null;
    try {
      const fileBlob = file.getBlob();
      const resource = { title: `[TEMP OCR] ${file.getName()}`, mimeType: fileBlob.getContentType() };
      const tempDocFile = Drive.Files.insert(resource, fileBlob, { ocr: true });
      tempDocId = tempDocFile.id;
      const text = DocumentApp.openById(tempDocId).getBody().getText();
      DriveApp.getFileById(tempDocId).setTrashed(true);
      return text; 
    } catch (e) {
      if (tempDocId) try { DriveApp.getFileById(tempDocId).setTrashed(true); } catch(err){}
      if (e.toString().includes("rate limit")) {
        attempts++;
        Utilities.sleep(attempts * 5000); 
      } else {
        return null; 
      }
    }
  }
  return null;
}

