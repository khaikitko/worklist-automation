function createDashboard() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let dashSheet = ss.getSheetByName(CONFIG.dashboardName);
  
  if (dashSheet) { ss.deleteSheet(dashSheet); }
  dashSheet = ss.insertSheet(CONFIG.dashboardName, 0); 
  dashSheet.setHiddenGridlines(true);

  // --- 1. GET DATA ---
  const dataSheet = ss.getSheetByName(CONFIG.sheetName);
  if (!dataSheet) return; 
  const data = dataSheet.getDataRange().getValues();
  const headers = data.shift(); 

  // Data Structures
  let activeProjects = [];   
  let stratWeeks = {}; 
  let stratTotalCounts = {}; 
  let allStrats = new Set(); 

  // --- 2. CRUNCH THE NUMBERS ---
  data.forEach(row => {
    const strat = row[CONFIG.colIndices.strat - 1]; 
    const status = String(row[CONFIG.colIndices.status - 1]).toLowerCase();
    const brand = row[CONFIG.colIndices.brand - 1];
    const project = row[CONFIG.colIndices.project - 1];
    const deadline = row[CONFIG.colIndices.deadline - 1];

    if (!strat || strat === "N/A" || status === "done" || status === "completed") return;

    allStrats.add(strat); 

    // Count Total Active Load
    if (!stratTotalCounts[strat]) stratTotalCounts[strat] = 0;
    stratTotalCounts[strat]++;

    let deadlineStr = "N/A";
    if (deadline instanceof Date) {
      deadlineStr = Utilities.formatDate(deadline, Session.getScriptTimeZone(), "dd/MM");
    }
    activeProjects.push([strat, brand, project, deadlineStr]);

    if (deadline instanceof Date) {
      const weekNum = getWeekNumber(deadline);
      const year = deadline.getFullYear();
      const weekKey = `${year} W${weekNum}`; 

      if (!stratWeeks[weekKey]) stratWeeks[weekKey] = {};
      if (!stratWeeks[weekKey][strat]) stratWeeks[weekKey][strat] = [];
      
      stratWeeks[weekKey][strat].push(deadlineStr);
    }
  });

  activeProjects.sort((a, b) => a[0].localeCompare(b[0]));

  // --- 3. BUILD THE UI ---
  dashSheet.getRange("C3").setValue("❤️ Team Well-being Monitor").setFontSize(24).setFontWeight("bold");
  dashSheet.getRange("C4").setValue(`Last Updated: ${Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "dd MMM HH:mm")}`);
  
  // DIVIDER LINE
  dashSheet.getRange("B6:L6").setBorder(null, null, true, null, null, null, "black", SpreadsheetApp.BorderStyle.SOLID);

  // ---------------------------------------------------------
  // SECTION A: FULL ACTIVE LIST
  // ---------------------------------------------------------
  dashSheet.getRange("C8").setValue("🔥 Active Brief List (Ongoing)").setFontSize(14).setFontWeight("bold");
  const listHeaders = [["Strategist", "Brand", "Proposal", "Due Date"]];
  dashSheet.getRange("C9:F9").setValues(listHeaders)
    .setFontWeight("bold").setBackground("#000000").setFontColor("#ffffff")
    .setBorder(true, true, true, true, true, true)
    .setHorizontalAlignment("center").setVerticalAlignment("middle");

  let leftRows = 0;
  if (activeProjects.length > 0) {
    leftRows = activeProjects.length;
    dashSheet.getRange(10, 3, leftRows, 4).setValues(activeProjects)
      .setBorder(true, true, true, true, true, true)
      .setHorizontalAlignment("center").setVerticalAlignment("middle");
  } else {
    dashSheet.getRange("C10").setValue("No active briefs!");
    leftRows = 1;
  }

  // ---------------------------------------------------------
  // SECTION B: OVERLOAD WATCH
  // ---------------------------------------------------------
  dashSheet.getRange("H8").setValue("🚨 Overload Watch (>3 Decks/Week)").setFontSize(14).setFontWeight("bold").setFontColor("black");
  
  dashSheet.getRange("H9").setValue("Strategist");
  dashSheet.getRange("I9:J9").merge().setValue("Critical Dates (Deadlines)"); 
  dashSheet.getRange("K9").setValue("Count"); 

  dashSheet.getRange("H9:K9")
    .setFontWeight("bold").setBackground("#ff0000").setFontColor("#ffffff")
    .setBorder(true, true, true, true, true, true)
    .setHorizontalAlignment("center").setVerticalAlignment("middle");

  let alertRow = 10;
  let riskFound = false;
  let suggestions = []; 

  // Track how many times someone has already been suggested
  let assignedReliefCounts = {}; 

  // Identify Overloads
  for (const [weekKey, stratsInWeek] of Object.entries(stratWeeks)) {
    for (const [stratName, dates] of Object.entries(stratsInWeek)) {
      if (dates.length > 3) {
        
        // 1. Populate Red Table
        const datesList = dates.join(", "); 
        dashSheet.getRange(alertRow, 8).setValue(stratName);
        dashSheet.getRange(alertRow, 9, 1, 2).merge().setValue(datesList).setWrapStrategy(SpreadsheetApp.WrapStrategy.WRAP);
        dashSheet.getRange(alertRow, 11).setValue(dates.length);
        alertRow++;
        riskFound = true;

        // 2. Find Relief Strategist (FAIR DISTRIBUTION)
        let bestCandidate = "None";
        let lowestEffectiveLoad = 99; // Tracks (Real Load + Already Assigned)
        let lowestTotalBacklog = 99;
        let candidateDeadlines = "";
        let foundAnyone = false;

        allStrats.forEach(candidate => {
          if (candidate === stratName) return; 
          
          // Calculate Real Load
          let realWeeklyLoad = 0;
          let activeDates = [];
          if (stratWeeks[weekKey] && stratWeeks[weekKey][candidate]) {
             activeDates = stratWeeks[weekKey][candidate];
             realWeeklyLoad = activeDates.length;
          }

          // Calculate "Effective Load" (Real + Already Assigned to help others)
          let assignedCount = assignedReliefCounts[candidate] || 0;
          let effectiveWeeklyLoad = realWeeklyLoad + assignedCount;

          let totalLoad = stratTotalCounts[candidate] || 0; 
          
          // Must have < 3 decks (Effectively) to be considered
          if (effectiveWeeklyLoad < 3) {
             foundAnyone = true;
             
             let isBetterCandidate = false;

             // Logic: Compare Effective Load (includes pending assignments)
             if (effectiveWeeklyLoad < lowestEffectiveLoad) {
               isBetterCandidate = true;
             } else if (effectiveWeeklyLoad === lowestEffectiveLoad) {
               // Tie-breaker: Total Backlog
               if (totalLoad < lowestTotalBacklog) {
                 isBetterCandidate = true;
               }
             }

             if (isBetterCandidate) {
                lowestEffectiveLoad = effectiveWeeklyLoad;
                lowestTotalBacklog = totalLoad;
                bestCandidate = candidate;
                
                // Formatting the display string
                let statusText = (realWeeklyLoad === 0) ? "Free this wk" : `Busy: ${activeDates.join(", ")}`;
                if (assignedCount > 0) statusText += ` (+${assignedCount} helping)`;
                
                candidateDeadlines = `Total Active: ${totalLoad} (${statusText})`;
             }
          }
        });

        if (!foundAnyone) {
           bestCandidate = "⚠️ NO ONE AVAILABLE";
           candidateDeadlines = "All strats saturated";
        } else {
           // Increment the counter for the chosen candidate so they aren't picked again immediately
           assignedReliefCounts[bestCandidate] = (assignedReliefCounts[bestCandidate] || 0) + 1;
        }

        suggestions.push([stratName, weekKey, bestCandidate, candidateDeadlines]);
      }
    }
  }

  let rightRows = alertRow - 10;
  if (!riskFound) {
    dashSheet.getRange(alertRow, 8).setValue("✅ No immediate burnout risks.");
    rightRows = 1;
  } else {
    dashSheet.getRange(10, 8, rightRows, 4).setBorder(true, true, true, true, true, true)
      .setHorizontalAlignment("center").setVerticalAlignment("middle");
  }

  // ---------------------------------------------------------
  // SECTION C: WORKLOAD RELIEF
  // ---------------------------------------------------------
  let suggestStartRow = alertRow + 2; 
  
  if (suggestions.length > 0) {
    dashSheet.getRange(suggestStartRow, 8).setValue("📉 Workload Relief Suggestions")
      .setFontSize(14).setFontWeight("bold").setFontColor("black");
    
    const suggestHeaders = [["Overloaded", "Week", "Suggested Strat", "Strat's Current Load"]];
    dashSheet.getRange(suggestStartRow + 1, 8, 1, 4).setValues(suggestHeaders)
      .setFontWeight("bold").setBackground("#0b5394") // Dark Blue
      .setFontColor("#ffffff")
      .setBorder(true, true, true, true, true, true)
      .setHorizontalAlignment("center").setVerticalAlignment("middle");

    dashSheet.getRange(suggestStartRow + 2, 8, suggestions.length, 4).setValues(suggestions)
      .setBorder(true, true, true, true, true, true)
      .setHorizontalAlignment("center").setVerticalAlignment("middle");
  }

  // ---------------------------------------------------------
  // SECTION D: THE CONTAINER
  // ---------------------------------------------------------
  
  let totalRightHeight = rightRows + 9;
  if (suggestions.length > 0) {
     totalRightHeight = suggestStartRow + suggestions.length + 3;
  }

  const maxTableHeight = Math.max(leftRows + 9, totalRightHeight) + 1; 
  
  // Draw Border B2 to L
  dashSheet.getRange(2, 2, maxTableHeight - 1, 11) 
    .setBorder(true, true, true, true, null, null, "black", SpreadsheetApp.BorderStyle.SOLID_THICK);

  // ---------------------------------------------------------
  // COLUMN SIZING
  // ---------------------------------------------------------
  dashSheet.setColumnWidth(1, 20);  // A
  dashSheet.setColumnWidth(2, 25);  // B
  
  dashSheet.setColumnWidth(3, 120); // C
  dashSheet.setColumnWidth(4, 120); // D
  dashSheet.setColumnWidth(5, 250); // E
  dashSheet.setColumnWidth(6, 80);  // F
  
  dashSheet.setColumnWidth(7, 30);  // G
  
  dashSheet.setColumnWidth(8, 120); // H
  dashSheet.setColumnWidth(9, 150); // I
  dashSheet.setColumnWidth(10, 150); // J
  dashSheet.setColumnWidth(11, 200); // K
  
  dashSheet.setColumnWidth(12, 25);  // L
}

